### Local environment example - do NOT commit secrets to VCS
# Copy this to .env and edit as needed for local development

# A shared development OTP used by contributors for testing (optional)
DEV_OTP=123456
ENV=development
API_BASE_URL=https://staging.sibuna.us
COUNTRY_CODE=+256
CURRENCY=UGX
COUNTRY_NAME=Uganda
PHONE_NUMBER_LENGTH=10

# Optional debug flags (uncomment to enable)
# BIM_AUTH_DEBUG=true
# BIM_AUTH_DEBUG_TTL_MIN=10

# Optional analytics / instrumentation keys
# ANALYTICS_KEY=